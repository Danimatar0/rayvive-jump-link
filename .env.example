# =============================================================================
# Rayvive environment variables
#
# EVERY variable in this file is PUBLIC. Vite inlines VITE_* values into the
# JavaScript bundle at build time, so anyone can read them in the browser.
# Never put a password, private key or API secret here.
#
# The two real secrets (ADMIN_PASSWORD and SESSION_SECRET) live as Script
# Properties inside the Google Apps Script project — see docs/ORDERS_SETUP.md.
# =============================================================================

# WhatsApp Business Configuration (customer support)
VITE_WHATSAPP_NUMBER=your_whatsapp_number

# Orders API — Google Apps Script Web App URL for the ORDERS spreadsheet.
# Required for checkout and the /orders admin dashboard to work.
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
VITE_ORDERS_API_URL=your_orders_apps_script_url

# Newsletter — separate Apps Script Web App for newsletter subscriptions
VITE_GOOGLE_SHEETS_URL=your_google_sheets_url

# Google Analytics
VITE_GA_TRACKING_ID=your_ga_tracking_id
